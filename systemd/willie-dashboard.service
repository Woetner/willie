# Started by willie-dashboard.socket; exits after dashboard.idle_minutes without requests.
[Unit]
Description=WILL-E dashboard (on demand)
Requires=willie-dashboard.socket

[Service]
Type=simple
User=willie
Group=willie
# Own user without sudo (tools/service_user.sh, security audit 25 Sep); the code stays
# @USER@'s and read-only for it. Group willie shares the runtime state with @USER@.
UMask=0007
Environment=WILLIE_CONFIG=@HOME@/.config/willie/willie.yaml
Environment=WILLIE_DATA=@HOME@/.local/share/willie
WorkingDirectory=@HOME@/willie
Environment=PYTHONUNBUFFERED=1
ExecStart=@HOME@/willie/.venv/bin/python -m willie.dashboard --fd 3
NonBlocking=yes
# RAM budget (§5.5): dashboard <= 35 MB target, hard stop at 64 MB
MemoryMax=64M
Restart=no
