# Installed by tools/install_service.sh (@USER@ / @HOME@ are filled in there).
# The always-on core: event bus, config, MCU link (later: mood, behaviour, face).
[Unit]
Description=WILL-E robot (core)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=willie
Group=willie
# Own user without sudo (tools/service_user.sh, security audit 25 Sep); the code stays
# @USER@'s and read-only for it. Group willie shares the runtime state with @USER@.
UMask=0007
Environment=WILLIE_CONFIG=@HOME@/.config/willie/willie.yaml
Environment=WILLIE_DATA=@HOME@/.local/share/willie
WorkingDirectory=@HOME@/willie
EnvironmentFile=-@HOME@/willie/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@HOME@/willie/.venv/bin/python -m willie
Restart=always
RestartSec=2
# RAM budget (D21, §5.5): core 35 + face 15 + voice session 45 = 95 MB.
# Above MemoryHigh the kernel reclaims hard; at MemoryMax a leak restarts the
# service instead of starving ssh.
MemoryHigh=110M
MemoryMax=128M

[Install]
WantedBy=multi-user.target
