# Installed by tools/install_service.sh (@USER@ / @HOME@ are filled in there).
# Hands-free WILL-E (D2): listens for "Hey Willie" / "Willie" on the Pi's own mic, then
# holds a Gemini Live conversation with the face, and goes back to listening after 30 s
# of silence. Nothing leaves the Pi until the wake word is heard (D17).
[Unit]
Description=WILL-E voice (wake word -> conversation)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=willie
Group=willie
# Own user without sudo (tools/service_user.sh, security audit 25 Sep); the code stays
# @USER@'s and read-only for it. Group willie shares the runtime state with @USER@.
UMask=0007
Environment=WILLIE_CONFIG=@HOME@/.config/willie/willie.yaml
Environment=WILLIE_DATA=@HOME@/.local/share/willie
# Switch the panel console to graphics mode while the face draws (runtime.Console).
AmbientCapabilities=CAP_SYS_TTY_CONFIG
WorkingDirectory=@HOME@/willie
EnvironmentFile=-@HOME@/willie/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@HOME@/willie/.venv/bin/python tools/willie_voice.py
Restart=always
RestartSec=5
# RAM (D21, §5.5): wake word ~30 + face ~17 + live session ~32 MB, measured 21 Sep.
MemoryHigh=130M
MemoryMax=160M

[Install]
WantedBy=multi-user.target
